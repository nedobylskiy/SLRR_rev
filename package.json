{
  "name": "slrr-independent-engine",
  "description": "An open-source engine remaster of Street Legal Racing: Redline, rebuilt for the browser with WebGL 2.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/slrr-jvm"
  ],
  "scripts": {
    "postinstall": "npm run build:jvm",
    "predev": "npm run build:jvm",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:jvm && tsc --noEmit && vite build",
    "build:jvm": "tsc -p packages/slrr-jvm/tsconfig.json",
    "build:wasm": "node tools/build-soft-body-wasm.mjs",
    "benchmark:soft-body": "tsx tools/benchmark-soft-body.ts",
    "benchmark:terrain": "tsx tools/benchmark-terrain.ts",
    "benchmark:vehicle-physics": "tsx tools/benchmark-vehicle-physics.ts",
    "test": "npm run build:jvm && tsx --test tests/*.test.ts",
    "test:wasm": "node --import tsx --import ./tools/enable-soft-body-wasm.ts --test tests/deformable-panel.test.ts tests/triangle-surface.test.ts tests/vehicle-3d.test.ts tests/soft-body-wasm.test.ts",
    "audit": "tsx tools/audit.ts",
    "audit:map-physics": "tsx tools/audit-map-physics.ts",
    "audit:map-lighting": "tsx tools/audit-map-lighting.ts",
    "audit:lightmap-usage": "tsx tools/audit-lightmap-usage.ts",
    "audit:java-math": "tsx tools/audit-java-math.ts",
    "verify:map-objects": "tsx tools/verify-map-objects.ts",
    "verify:game": "tsx tools/verify-game.ts",
    "verify:traffic-java": "tsx tools/verify-traffic-java.ts",
    "verify:minimap": "tsx tools/verify-minimap.ts",
    "verify:skeleton": "tsx tools/verify-skeleton.ts",
    "verify:ragdoll": "tsx tools/verify-ragdoll.ts",
    "verify:pedestrians": "tsx tools/verify-pedestrians.ts",
    "verify:saves": "tsx tools/verify-saves.ts",
    "inspect:class": "tsx tools/inspect-class.ts",
    "verify:vm": "tsx tools/verify-vm.ts",
    "verify:parts": "tsx tools/verify-parts.ts",
    "verify:world": "tsx tools/verify-world.ts",
    "verify:gameplay": "tsx tools/verify-gameplay.ts",
    "verify:java-boot": "tsx tools/verify-java-boot.ts",
    "decompile:system": "tsx tools/decompile-system-sources.ts",
    "verify:mounts": "tsx tools/verify-mounts.ts",
    "verify:hood": "tsx tools/verify-hood.ts",
    "verify:crash": "tsx tools/verify-crash.ts",
    "verify:3d": "tsx tools/verify-3d.ts",
    "verify:components": "tsx tools/verify-components.ts",
    "report:stock-benchmark": "tsx tools/report-stock-benchmark.ts",
    "report:natives": "tsx tools/report-native-status.ts",
    "measure:stock-drive": "tsx tools/measure-stock-drive.ts",
    "verify:stock-drive": "tsx tools/measure-stock-drive.ts --verify",
    "verify:suspension-road": "tsx tools/verify-suspension-road.ts",
    "verify:suspension-skinning": "tsx tools/verify-suspension-skinning.ts",
    "verify:driver-ik": "tsx tools/verify-driver-ik.ts"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "slrr-jvm": "file:packages/slrr-jvm",
    "slrr-jvm-decompiler": "github:nedobylskiy/SLRR-JVM-decompiler#54f953d",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
